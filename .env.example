# ==============================================================================
# MOHIT'S PORTFOLIO AI — GOOGLE GEMINI ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' and enter your Google AI Studio Gemini API key.
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Note: Keep '.env' private and never commit it to source control.
# ==============================================================================

# Server-Side Gemini API Configuration (Never exposed to the browser)
# Do NOT prefix with VITE_ to prevent leaking secrets to client bundles.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supported Free-Tier Gemini Models (as of 2026):
# - gemini-3.5-flash-lite (Recommended — confirmed free tier, fast & efficient)
# - gemini-3.5-flash      (Free tier, more capable)
# - gemini-3.8-flash      (Latest, highly capable)
# Note: gemini-2.5-flash-lite and gemini-2.5-flash are NOT available to new users

# Operational Mode Configuration
# DEMO_MODE=true  -> Uses local offline portfolio knowledge base
# DEMO_MODE=false -> Uses live Google Gemini API
DEMO_MODE=false

# Optional Server Configuration
PORT=3001
REQUEST_TIMEOUT_MS=20000

# Client-Side Chat Mode ('live' or 'demo')
VITE_CHAT_MODE=live

